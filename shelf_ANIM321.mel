        -annotation "Group each object without breaking hierarchy" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Group In Place" 
        -labelOffset 0
        -rotation 0
