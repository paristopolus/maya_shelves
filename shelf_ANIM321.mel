        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n# Make a locator for each object in selection and group it under a node.\n\nobjs = cmds.ls(selection=True) # Get Selection\ngrp = cmds.group( em=True, name='locators' )\n\nfor obj in objs:\n    cmds.select(clear=True)\n    loc = cmds.spaceLocator()\n    nm = ( obj + '_loc' )\n    constr = cmds.parentConstraint( obj, loc, mo=False )\n    cmds.delete(constr)\n    cmds.parent( loc, grp )\n    cmds.rename(loc, nm)\n\ncmds.select(grp)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
