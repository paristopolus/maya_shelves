        -command "import maya.cmds as cmds\n\n# Make a joint for each object in selection and group it under a node.\n\nobjs = cmds.ls(selection=True) # Get Selection\ngrp = cmds.group( em=True, name='joints' )\n\nfor obj in objs:\n    cmds.select(clear=True)\n    loc = cmds.joint()\n    nm = ( obj + '_jnt' )\n    constr = cmds.parentConstraint( obj, loc, mo=False )\n    cmds.delete(constr)\n    cmds.parent( loc, grp )\n    cmds.rename(loc, nm)\n\ncmds.select(grp)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
