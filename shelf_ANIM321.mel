        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n# Make a group for each object in selection and parent object to new group.\n\nobjs = cmds.ls(selection=True) # Get Selection\n\nfor obj in objs:\n    parList = cmds.listRelatives(obj, parent=True) # get the parents\n    par = parList[0] # immediate parent\n    cmds.select(clear=True) # clear selection\n    nm = ( obj + '_grp' )\n    grp = cmds.group( em=True)\n    constr = cmds.parentConstraint( obj, grp, mo=False )\n    cmds.delete(constr)\n    cmds.parent( grp, par )\n    cmds.parent( obj, grp )\n    cmds.rename( grp, nm ) \n\ncmds.select(objs) # re-select everything" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
