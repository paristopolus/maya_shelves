        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n# Make a group for each object in selection and parent object to new group.\n\nobjs = cmds.ls(selection=True) # Get Selection\n\nfor obj in objs:\n    cmds.select(clear=True)\n    nm = ( obj + '_OFFSET' )\n    grp = cmds.group( em=True, name=nm)\n    constr = cmds.parentConstraint( obj, grp, mo=False )\n    cmds.delete(constr)\n    cmds.parent( obj, grp )\n\ncmds.select(grp)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
