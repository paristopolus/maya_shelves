        -command "import maya.cmds as cmds\n\n# Make ctrl for each object in selection and group it under a node.\n\nobjs = cmds.ls(selection=True) # Get Selection\ngrp = cmds.group( em=True, name='generated_ctrls' )\n\nfor obj in objs:\n    cmds.select(clear=True)\n    nm = ( obj + '_ctrl' )\n    ctrl = cmds.circle(r=1.5, n=nm)\n    constr = cmds.parentConstraint( obj, ctrl, mo=False )\n    cmds.delete(constr)\n    cmds.parent( ctrl, grp )\n\ncmds.select(grp)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
