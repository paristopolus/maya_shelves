        -image "noAccess.png" 
        -image1 "noAccess.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "# Better Rename. Select Top Parent\nimport maya.cmds as cmds\n\nsel = cmds.ls(selection=True)\ncmds.select(clear=True)\nselectAgain = True # select the object again?\n\ntgts = [\"FBX\"] \nobjs = cmds.listRelatives(sel,allDescendents=True,type=\"transform\",fullPath=True) # list children in reverse full path to object\nobjShort = cmds.listRelatives(sel,allDescendents=True,type=\"transform\") # list children in reverse short name     \n\nfor i in range(len(objs)):\n    for tgt in tgts:\n        obj = objs[i]\n        objSh = objShort[i]\n        \n        nm = objSh # get name\n        match = nm.find(tgt)\n        if(match>=0):\n            new = nm.replace( tgt, \"_\")\n            cmds.rename(obj,new) # apply renamed \"short\" name to the \"long\" named object\n           \nif(selectAgain):\n    cmds.select(sel)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
