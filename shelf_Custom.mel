        -annotation "Retarget Textures to a new directory" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Retarget Textures" 
        -labelOffset 0
        -rotation 0
        -flipX 0
