        -image1 "pythonFamily.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n# Move selection to last thing selected.\n\nobjs = cmds.ls(selection=True) # Get Selection\n\ntarget = objs[len(objs)-1]\n\nfor obj in objs:\n    cmds.select(clear=True)\n    if(obj!=target):\n        constr = cmds.parentConstraint( target, obj, mo=False )\n        cmds.delete(constr)\n\ncmds.select(objs)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Parent and Scale Constraint the first to the last selected;" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "import maya.cmds as cmds\n\n# Match the scale of the first to the ..." 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "psCnst" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "scale_M.png" 
        -image1 "scale_M.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n# Match the scale of the first to the last selected;\n\nobjs = cmds.ls(selection=True) # Get Selection\ncmds.select(clear=True)\n\nfor obj in objs:\n    tgt = obj.replace(\"_XPRT_\",\"_\")\n    if(cmds.objExists(tgt)):\n        print(tgt)\n        cmds.scaleConstraint( tgt, obj, mo=False )\n        cmds.parentConstraint( tgt, obj, mo=False )\n\ncmds.select(objs)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Make a Selection Set for each node selected. NOTE: Wise to choose groups when making for devices." 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Make Selection Set" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "CryptoSet" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "pythonFamily.png" 
        -image1 "pythonFamily.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n# Make a selection set with a crypto_asset for each object\n\nobjs = cmds.ls(selection=True) # Get Selection\ncmds.select(clear=True)\nprefix = \"set_CryptoAsset_\"\nallSelSets = []\nasset = \"mtoa_constant_crypto_asset\"\nrefl = \"mtoa_constant_reflect_index\";\nrow = \"mtoa_constant_row\";\ncol = \"mtoa_constant_col\";\nassetPrefix = \"lyr\"\n\nfor i in range(len(objs)):\n    cmds.select(clear=True)\n    \n    obj = objs[i]\n    tag = i+1\n    serialize = (f'{tag:03}')\n    subSetName = prefix + serialize\n    assetTag = assetPrefix + serialize\n    \n    # select individual object; make selection set\n    cmds.select(obj)\n    subSet = cmds.sets(name=subSetName)\n    allSelSets.append(subSetName)\n    \n    # Add attributes for Crypto Asset\n    cmds.addAttr(subSet, ln=asset, dataType=\"string\")\n    objAttr = subSet + \".\" + asset\n    cmds.setAttr(objAttr, assetTag, type=\"string\")\n    \n    #Add attributes for Reflect Index\n    cmds.addAttr(subSet, ln=refl, keyable=True, at=\"float\")\n    objAttr = subSet + \".\" + refl\n    cmds.setAttr(objAttr, tag)\n\n\t#Add attributes for Row\n    cmds.addAttr(subSet, ln=row, keyable=True, at=\"float\")\n    objAttr = subSet + \".\" + row\n    cmds.setAttr(objAttr, 0)\n    \n    #Add attributes for Col\n    cmds.addAttr(subSet, ln=col, keyable=True, at=\"float\")\n    objAttr = subSet + \".\" + col\n    cmds.setAttr(objAttr, 0)\n    \n# Create a master selection set\nsetName = \"set_Crypto_Assets\"\nmasterSet = cmds.sets(allSelSets,name=setName)\ncmds.select(masterSet)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
