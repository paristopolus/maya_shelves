        -command "import maya.cmds as cmds\nimport os\n\nsuffix = \"_geo\"\nsel = cmds.ls(selection=True)\ncmds.select(clear=True)\n\nfor i in range(len(sel)):\n    obj = sel[i]\n    newName = obj + suffix\n    cmds.rename(obj, newName)\n\ncmds.select((\"*\"+suffix))" 
