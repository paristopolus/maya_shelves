        -annotation "Removes the \"FBX\" from imported FBX files. Select the buttom of the group to the top." 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Replace FBX" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "FBX" 
        -overlayLabelColor 0.8 0.8 0.8 
