        -annotation "Will convert all materials in the scene to arnold standardSurfaces" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Misc2ArnoldMat" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "m2ai" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "material_template_create.png" 
        -image1 "material_template_create.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n# Get all materials in the scene\nmaterials = cmds.ls(materials=True)\n\nfor mat in materials:\n    # Create new Arnold aiStandardSurface material\n    arnold_mat = cmds.shadingNode('aiStandardSurface', asShader=True, name=mat)\n\n    # Get shading groups connected to the original material\n    shading_groups = cmds.listConnections(mat, type='shadingEngine') or []\n\n    for sg in shading_groups:\n        # Get objects assigned to the shading group\n        objects = cmds.sets(sg, q=True) or []\n\n        for obj in objects:\n            # Assign the new Arnold material to the object\n            cmds.select(obj)\n            cmds.hyperShade(assign=arnold_mat)\n\nprint(\"Converted materials to Arnold aiStandardSurface successfully!\")" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
