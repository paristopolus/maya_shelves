        -image "textureEditorCheckered.png" 
        -image1 "textureEditorCheckered.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "# Maya: Relink missing textures to a chosen directory\n# Works by finding unresolved file path attributes via filePathEditor, then setting them to matching files.\n\nimport os\nimport maya.cmds as cmds\n\ndef _norm(path):\n    \"\"\"Normalize for Maya: forward slashes + no trailing slashes (except root).\"\"\"\n    if not path:\n        return path\n    path = os.path.normpath(path).replace('\\\\', '/')\n    return path\n\ndef _build_filename_index(root_dir, recursive=True):\n    \"\"\"\n    Build a dict: lower(filename) -> fullpath\n    If duplicate filenames exist, keeps the first one found.\n    \"\"\"\n    index = {}\n    root_dir = _norm(root_dir)\n\n    if not os.path.isdir(root_dir):\n        return index\n\n    if recursive:\n        for base, _, files in os.walk(root_dir):\n            for f in files:\n                key = f.lower()\n                if key not in index:\n                    index[key] = _norm(os.path.join(base, f))\n    else:\n        for f in os.listdir(root_dir):\n            full = os.path.join(root_dir, f)\n            if os.path.isfile(full):\n                key = f.lower()\n                if key not in index:\n                    index[key] = _norm(full)\n    return index\n\ndef find_missing_texture_plugs():\n    \"\"\"\n    Returns a list of attribute plugs (e.g. 'file1.fileTextureName') that are unresolved.\n    Uses filePathEditor, which is designed to query and manipulate external file paths in bulk. [1](https://help.autodesk.com/cloudhelp/2022/ENU/Maya-Tech-Docs/CommandsPython/filePathEditor.html)[2](https://help.autodesk.com/cloudhelp/2025/ENU/Maya-Tech-Docs/Commands/filePathEditor.html)\n    \"\"\"\n    # Refresh + focus unresolved items\n    try:\n        cmds.filePathEditor(refresh=True)\n    except Exception:\n        pass\n\n    # 'unresolved' filters to missing/broken paths. [1](https://help.autodesk.com/cloudhelp/2022/ENU/Maya-Tech-Docs/CommandsPython/filePathEditor.html)[2](https://help.autodesk.com/cloudhelp/2025/ENU/Maya-Tech-Docs/Commands/filePathEditor.html)\n    try:\n        cmds.filePathEditor(unresolved=True, refresh=True)\n    except Exception:\n        # Some Maya versions may not allow unresolved flag with refresh; that's ok\n        pass\n\n    # listFiles returns file entries; attributeOnly returns the plug names. [1](https://help.autodesk.com/cloudhelp/2022/ENU/Maya-Tech-Docs/CommandsPython/filePathEditor.html)[3](https://qiita.com/aizwellenstan/items/064d058057648d89554c)\n    plugs = cmds.filePathEditor(q=True, listFiles=\"\", attributeOnly=True) or []\n\n    # Filter out plugs that aren't settable (or are references) if desired\n    missing = []\n    for plug in plugs:\n        try:\n            # If it's a reference node entry, the nodeType may be \"reference\" and needs different handling.\n            # We primarily want texture/image file plugs, so we keep only plugs that exist and are attributes.\n            if \".\" in plug and cmds.objExists(plug.split(\".\")[0]):\n                missing.append(plug)\n        except Exception:\n            continue\n\n    # De-dup preserving order\n    seen = set()\n    out = []\n    for p in missing:\n        if p not in seen:\n            seen.add(p)\n            out.append(p)\n    return out\n\ndef relink_missing_textures(search_dir=None, recursive=True, preview_only=False):\n    \"\"\"\n    - search_dir: directory to search for textures (if None, prompts user)\n    - recursive: search subdirectories\n    - preview_only: if True, prints what would change but does not setAttr\n    \"\"\"\n    # Ask for folder if not provided\n    if not search_dir:\n        # mode=4 is \"directory\" in Maya file dialog\n        selected = cmds.fileDialog2(dialogStyle=2, fileMode=3, caption=\"Choose texture directory to search\") or []\n        if not selected:\n            cmds.warning(\"No directory selected. Aborting.\")\n            return\n        search_dir = selected[0]\n\n    search_dir = _norm(search_dir)\n    if not os.path.isdir(search_dir):\n        cmds.warning(\"Directory does not exist: {}\".format(search_dir))\n        return\n\n    missing_plugs = find_missing_texture_plugs()\n    if not missing_plugs:\n        print(\"? No missing/unresolved texture paths found.\")\n        return\n\n    print(\"Found {} unresolved file path attributes.\".format(len(missing_plugs)))\n    print(\"Indexing files in: {} (recursive={})\".format(search_dir, recursive))\n\n    filename_index = _build_filename_index(search_dir, recursive=recursive)\n\n    fixed = []\n    still_missing = []\n\n    for plug in missing_plugs:\n        try:\n            old_path = cmds.getAttr(plug)\n        except Exception:\n            # Some plugs may not be readable\n            still_missing.append((plug, None, None))\n            continue\n\n        if not old_path:\n            still_missing.append((plug, old_path, None))\n            continue\n\n        # Match by filename\n        fname = os.path.basename(old_path).lower()\n        new_path = filename_index.get(fname)\n\n        if new_path and os.path.isfile(new_path):\n            if preview_only:\n                print(\"[PREVIEW] {}: {} -> {}\".format(plug, old_path, new_path))\n            else:\n                try:\n                    cmds.setAttr(plug, new_path, type=\"string\")\n                    fixed.append((plug, old_path, new_path))\n                    print(\"? Fixed: {} -> {}\".format(plug, new_path))\n                except Exception as e:\n                    still_missing.append((plug, old_path, new_path))\n                    print(\"? Failed to set {} ({}): {}\".format(plug, new_path, e))\n        else:\n            still_missing.append((plug, old_path, None))\n            print(\"?? Not found for {} (looking for filename: {})\".format(plug, os.path.basename(old_path)))\n\n    print(\"\\n========== SUMMARY ==========\")\n    print(\"Fixed: {}\".format(len(fixed)))\n    print(\"Still missing / failed: {}\".format(len(still_missing)))\n\n    if still_missing:\n        print(\"\\n--- Unresolved entries ---\")\n        for plug, old_path, candidate in still_missing:\n            print(\" • {} | old: {} | candidate: {}\".format(plug, old_path, candidate))\n\n    return fixed, still_missing\n\n# Run it:\n# relink_missing_textures()  # prompts for directory\nrelink_missing_textures()" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
