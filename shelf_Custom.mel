        -image "publishAttributes.png" 
        -image1 "publishAttributes.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "## Publish file\n# Publish\nimport maya.cmds as cmds\nimport os\n\ndef export_publish_sets():\n    # Check that scene is saved\n    scene_path =  cmds.file(q=True, sn=True)\n    if not scene_path:\n        cmds.confirmDialog(message=\"Please save the scene before exporting.\", button=\"close\")\n        return\n        \n    working_dir  = os.path.dirname(scene_path)\n    publish_dir = working_dir.split( \"__working__\")[0]\n\n    scene_name_full = os.path.splitext(os.path.basename(scene_path))[0]\n    scene_ext = os.path.splitext(os.path.basename(scene_path))[1]\n    scene_name = scene_name_full[:-5] # remove the take serialization\n    \n    # Find all selection sets ending in \"_publish\"\n    publish_sets = [s for s in cmds.ls(type=\"objectSet\") if s.endswith(\"_publish\")]\n    if not publish_sets:\n        cmds.confirmDialog(message=\"No *_publish sets found in the scene.\", button=\"close\")\n        return\n        \n    # Export directory\n    export_dir = os.path.join(publish_dir, \"publish\")\n    if not os.path.exists(export_dir):\n        os.makedirs(export_dir)\n\n    for s in publish_sets:\n        members = cmds.sets(s, q=True)\n        if not members:\n            cmds.warning(\"Set '{}' is empty, skipping.\".format(s))\n            continue\n\n        export_path = os.path.join(export_dir, \"{}.mb\".format(scene_name))\n\n        try:\n            cmds.select(members, r=True)\n            cmds.file(\n                export_path,\n                force=True,\n                options=\"v=0;\",\n                typ=\"mayaBinary\",\n                pr=True,\n                es=True\n            )\n            print(\"Exported: {}\".format(export_path))\n        except Exception as e:\n            cmds.confirmDialog(\"Failed to export '{}': {}\".format(s, e), button=\"close\")\n            return\n    \n    cmds.select(clear=True)\n\n    # Version Up\n    scene_meta = scene_name.split(\"_\")\n    cur_ver = int(scene_meta[1].split(\"v\")[1]) # get version\n    new_ver = \"v\" + f\"{(cur_ver + 1):03d}\"\n    new_scene_name = scene_meta[0] + \"_\" + new_ver + \"_t001\"\n    new_full_path = working_dir + \"/\" + new_scene_name + scene_ext\n    cmds.file(rename=new_full_path)\n    cmds.file(save=True, force=True)\n\nexport_publish_sets()" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
