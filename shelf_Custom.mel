        -command "# convert selection to same selection plus namespace\nimport maya.cmds as cmds\n\nobjs = cmds.ls(selection=True)\ncmds.select(clear=True)\nnmsp = \"VW3:\"\noldnmsp = \"og\"\nselObjs = []\n\nfor obj in objs:\n    rebuilt = obj.replace(oldnmsp,(nmsp)) # use this when there is a name space\n    selObjs.append(rebuilt)\n\ncmds.select(selObjs)\nprint(objs)\nprint(selObjs)  \n\n''' # use this when there is no namespace\nnmsp = \"VW3:\"\nselObjs = []\n\nfor obj in objs:\n    rebuilt = obj.replace(\"|\",(\"|\"+nmsp))\n    selObjs.append((nmsp + rebuilt))\n\ncmds.select(selObjs)\nprint(objs)\nprint(selObjs)  \n'''" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
