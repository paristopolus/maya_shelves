        -annotation "Search for duplicates and rename - select top node in hierarchy" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Solve duplicates" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "Dupes" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "selectUnsortedNodes.png" 
        -image1 "selectUnsortedNodes.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "from maya import cmds\nimport random\n\n# How to solve duplicate names\n\nsel = cmds.ls(selection=True)\ncmds.select(clear=True)\nselectAgain = True # select the object again?\n\nobjs = cmds.listRelatives(sel,allDescendents=True,type=\"transform\",fullPath=True) # list children in reverse full path to object\nobjShort = cmds.listRelatives(sel,allDescendents=True,type=\"transform\") # list children in reverse short name\nseenShapes = [[],[],[],[]] # short, long, osh, olg\nfor i in range(len(objs)):\n    obj = objs[i]\n    curShapes = cmds.listRelatives(obj,allDescendents=True,fullPath=True,shapes=True) # list children in reverse long name\n    curShapesShort = cmds.listRelatives(obj,allDescendents=True,shapes=True) # list children in reverse short name\n    if(curShapes!=None):\n        seenShapes[0].append(curShapesShort[0]) \n        seenShapes[1].append(curShapes[0])\n        seenShapes[2].append(objShort[i])\n        seenShapes[3].append(obj)\n\ndupes = [[],[],[],[],[]] # short, long, osh, olg, wild\nprevShapes = set()\n\nfor i in range(len(seenShapes[0])):\n    shsh = seenShapes[0][i]\n    # get all duplicate object and shape nmaes    \n    if shsh in prevShapes:\n        dupes[0].append(seenShapes[0][i]) # short shape\n        dupes[1].append(seenShapes[1][i]) # long shape\n        dupes[2].append(seenShapes[2][i]) # short object\n        dupes[3].append(seenShapes[3][i]) # long object\n        wildcard = \"*\" + seenShapes[0][i] # short shape with wildcard upfront\n        dupes[4].append(wildcard)\n    else:  \n        prevShapes.add(shsh)\n\nprint(\"The dupes are -->\")\nfor i in range(len(dupes[0])):\n    wild_str = \"*\" + dupes[0][i]\n\nallDupeSh = [[],[],[],[]] # short shape, long shape, shot obj, long obj\nif(len(dupes[4])>0):\n    cmds.select(dupes[4]) # select duplicates\n    \n    dupLgSh = cmds.ls(selection=True,shortNames=True) # store selection\n    dupShObj = []\n    dupShSh = []\n    dupLgObj = []\n    \n    for s in dupLgSh:\n        objectLgNm = cmds.listRelatives(s,parent=True,fullPath=True)\n        objectShNm = cmds.listRelatives(s,parent=True)\n        shapeShortName = cmds.listRelatives(objectLgNm,allDescendents=True)\n        dupShSh.append(shapeShortName[0])\n        dupShObj.append(objectShNm[0])\n        dupLgObj.append(objectLgNm[0])\n    \n    # add to dupes array\n    allDupeSh[0] = dupShSh    \n    allDupeSh[1] = dupLgSh\n    allDupeSh[2] = dupShObj\n    allDupeSh[3] = dupLgObj\n    \n    suffix = \"_geo\"\n         \n    for i in range(len(allDupeSh[0])):\n        serial =  random.randrange(100, 200, 1)\n        enum = str(i)\n        full_name = allDupeSh[3][i]\n        full_shape = allDupeSh[1][i]\n        old_name = allDupeSh[2][i]\n        old_name = old_name.replace(suffix,\"_\")\n        new_name = old_name + str(serial) + suffix\n        new_shape_name = new_name + \"Shape\"\n        \n        \n        # rename shape then object\n        cmds.rename(full_shape,new_shape_name)\n        cmds.rename(full_name,new_name)\n        \n        print(\"-------------------\")\n        print(full_name)\n        print(full_shape)\n        print(new_name)\n        print(new_shape_name)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
