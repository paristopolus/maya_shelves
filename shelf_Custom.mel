        -preventOverride 0
        -annotation "Speedo :: select an object and calculate its velocity" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "Speedo" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -imageOverlayLabel "Speedo" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "time.svg" 
        -image1 "time.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "# Speedo.py :: select an object and calculate its velocity.\nimport maya.cmds as cmds\nimport mtoa.core as core \nimport maya.mel as mel\n\nsel = cmds.ls( selection=True ) # get selection\n\ndef convert2String( target ):\n    header = \"import maya.cmds as cmds;\"\n    speed = f\"speed = [ cmds.getAttr('{target}.mph'),cmds.getAttr('{target}.kph') ];\"\n    objectTitle = \"'speed: '\" \n    formatted = \"+ str(round(speed[0],2)) + ' mph / ' + str(round(speed[1],2)) + ' kph'\"\n    converted = header + speed + objectTitle + formatted\n    return converted\n\ndef buildPythonConverter(velocityTarget, type_object): \n    print(f\"creating aiUserDataScript and converting python to in-line script for typeNode...\")\n    converter = core.createArnoldNode(\"aiUserDataString\", name=\"pythonConverter\" )\n    inLineScript = convert2String( velocityTarget )\n    cmds.setAttr( converter + \".attribute\", \"container\", type=\"string\" )\n    cmds.setAttr( converter + \".default\", inLineScript, type=\"string\" )\n    cmds.connectAttr( converter + \".default\", type_object + \".pythonExpression\", force=True )\n\ndef setTypeAttr( typeObject, connections ): \n    print(f\"setting type attributes, and prepping script conversion...\")\n    cmds.setAttr( typeObject + \".fontSize\", 1 ) # set font size to 2.\n    cmds.setAttr( typeObject + \".generator\", 9 ) # set to python generation.\n    for node in connections:\n        if( cmds.nodeType(node)==\"typeExtrude\" ): # turn off the extrusion.\n            cmds.setAttr(node + \".enableExtrusion\", 0)\n\ndef getTypeConnections(object_name): # Get all connections to type node.\n    connections = cmds.listConnections( object_name ) or []\n    if connections:\n        for conn in connections:\n            node_type = cmds.nodeType(conn)\n            print(f\"Node: {conn}, Type: {node_type}\")\n        return connections\n\ndef getTypeNode(object_name): #find type node.\n    connections = cmds.listConnections( object_name, type=\"type\" ) or []\n    node = None\n    if connections:\n        for conn in connections:\n            node_type = cmds.nodeType(conn)\n            if (node_type==\"type\"):\n                node = conn\n                print(f\"Node: {conn}, Type: {node_type}\")\n    else:\n        print(f\"No connections found for {type_mesh_name}.\")\n    \n    return node\n\ndef buildDisplay(velocity_loc): \n    print(f\"creating type mesh, nodes and scripts\")\n    type = mel.eval( 'CreatePolygonType;' )\n    typeMesh = cmds.rename( type, \"velocity_typeMesh\" )       \n    typeNode = getTypeNode( typeMesh )\n    typeConnections = getTypeConnections( typeNode )\n    setTypeAttr( typeNode,typeConnections )\n    buildPythonConverter( velocity_loc, typeNode )\n    grp = checkGrp( \"utility_grp\" )\n    cmds.parent( typeMesh, grp )\n\ndef makeExpr(vloc,frameRate,scaleOption): \n    print(f\"building expression...\")\n    header = f\"// speedo.py :: an expression to calculate velocity. \\n\"\n    time = f\"float $t = `currentTime -q`;\\n\"\n    fps = f\"float $fps = \"+str(frameRate)+\"; // seconds-per-frame\\n\"\n    last = f\"float $last[] = `getAttr -time ($t-1) {vloc}.translate`;\\n\"\n    dx = f\"float $dx = tx - $last[0];\\n\"\n    dy = f\"float $dy = ty - $last[1];\\n\"\n    dz = f\"float $dz = tz - $last[2];\\n\" \n    dist = f\"float $dist = (sqrt($dx*$dx+$dy*$dy+$dz*$dz)) * {scaleOption};\\n\"\n    speed = f\"{vloc}.speed = $dist;\\n\"\n    kph = f\"{vloc}.kph = $dist * $fps * 3600 / 1e5;\\n\"\n    mph = f\"{vloc}.mph = kph / 1.609344\\n\"\n    \n    # concatenate & apply expression\n    expr = header + time + fps + last + dx + dy + dz + dist + speed + kph + mph\n    cmds.expression( object=vloc, string=expr, name=\"speedoExpr\", alwaysEvaluate=0, unitConversion=\"all\" )\n\t\ndef makeAttrs(obj):\n    print(f\"adding the speedometer attributes and making them keyable/visible in the channel box\")\n    attrs = [\"speed\",\"kph\",\"mph\"]\n    cmds.addAttr( obj, longName=attrs[0], attributeType=\"double\", keyable=True )  \n    cmds.addAttr( obj, longName=attrs[1], attributeType=\"double\", keyable=True )  \n    cmds.addAttr( obj, longName=attrs[2], attributeType=\"double\", keyable=True )  \n    return attrs\n\ndef convertFPS(arg): # query Maya's built-in string-based fps\n    switcher = {\n        \"game\": \"15 fps\",\n        \"film\": \"24 fps\",\n        \"pal\": \"25 fps\",\n        \"ntsc\": \"30 fps\",\n        \"show\": \"48 fps\",\n        \"palf\": \"50 fps\",\n        \"ntscf\": \"60 fps\",\n    }\n    \n    return switcher.get( arg, arg)\n\ndef getFPSNum(): # format fps to float.\n    rawFps = cmds.currentUnit(query=True, time=True)\n    fps = convertFPS(rawFps)\n    fps = float(fps.split(\"fps\")[0])\n    return fps\n\ndef checkGrp(groupName): \n    print(f\"using a group named 'utility' or making one...\")\n    grpList = cmds.ls( groupName )\n    if(len(grpList)!=1):\n        grp = cmds.group( em=True, name=groupName )\n    else:\n        grp=grpList[0]\n    return grp\n\ndef constrVert(vertex):  # Full vertex name (e.g., \"pCube1.vtx[11]\")\n    print( \"the vertex is \" + str(vertex) )\n    mesh_name = vertex.split(\".\")[0]  # Extract mesh name\n    print(mesh_name + \" is being worked on.\")\n    \n    # Create a locator\n    locator = cmds.spaceLocator(name=(mesh_name + \"_vLoc\"))[0]\n    \n    # Apply pointOnPolyConstraint\n    constraint = cmds.pointOnPolyConstraint(mesh_name, locator, maintainOffset=False)[0]\n\n    # Get the uv count per vertex and print if there is a mis-match.\n    uv_count = cmds.polyEvaluate(mesh_name, uv=True)\n    print(f\"Mesh '{mesh_name}' has {uv_count} UVs.\")\n    \n    # Get UV coordinates of the vertex\n    uvs = cmds.polyListComponentConversion(vertex, fromVertex=True, toUV=True)\n    uvs = cmds.ls(uvs, flatten=True)\n\n    if uvs:\n        uv_pos = cmds.polyEditUV(uvs[0], query=True)\n        print(f\"UV position for {vertex}: {uv_pos}\")\n        cmds.setAttr(f\"{constraint}.{mesh_name}U0\", uv_pos[0])\n        cmds.setAttr(f\"{constraint}.{mesh_name}V0\", uv_pos[1])\n    \n        \n    print(f\"Locator '{locator}' is now constrained to vertex '{vertex}' via {constraint}.\")\n    \n    return locator\n    \n\ndef cnstPos(obj): \n    loc = None\n\n    if( \".vtx\" in obj ):\n        loc = constrVert(obj)\n    else: # else just make locator at object's location\n        loc = cmds.spaceLocator( name=obj + '_vLoc' )[0]\n        constr = cmds.parentConstraint( obj, loc, mo=False )\n    print(f\"The locator is {loc}\")\n    return loc\n\ndef collectParams(objs,scaleOption): \n    print(f\"collecting parameters to build expression...\")\n    obj = objs[0]\n    loc = cnstPos(obj)\n    fps = getFPSNum()\n    attrs = makeAttrs(loc)\n    makeExpr(loc,fps,scaleOption)\n    buildDisplay(loc)\n    grp = checkGrp( \"utility_grp\" )\n    cmds.parent( loc, grp )\n\ndef setWorkingScale(objs,scaleOption): # store working scale.\n    scaleValue = cmds.floatField( scaleOption, query=True, value=True )\n    workingScale = scaleValue;\n    cmds.select(clear=True) # clear selection\n    collectParams(objs,workingScale)\n    if cmds.window( \"scalePromptWin\", exists=True ):\n        cmds.deleteUI( \"scalePromptWin\" )\n        \ndef create_scale_prompt(objs): # check scale.\n    if cmds.window( \"scalePromptWin\", exists=True ):\n        cmds.deleteUI( \"scalePromptWin\" )\n    \n    width = 260\n    height = 150\n    \n    cmds.window(\"scalePromptWin\", title=\"Speedo\", widthHeight=(width, height))\n    # Use a form layout for better control of spacing\n    cmds.formLayout(\"mainLayout\", parent=\"scalePromptWin\")\n\n    # Frame layout adds a subtle border\n    frame = cmds.frameLayout(labelVisible=False, marginWidth=20, marginHeight=20)\n\n    cmds.columnLayout(adjustableColumn=False, columnAlign=\"center\")\n\n    cmds.text( label=\"The scale multiplier is 10 by default.\\n (PREYMAKER 10th scale) \\n Set the multiplier to 1 for world scale.\", wordWrap=True, width=(width-10) )\n    \n    cmds.separator( style=\"in\", height=10 )  # Adds spacing\n    scaleOption = cmds.floatField(\"scaleInput\", value=10, precision=1, width=(width-10) ) # scale ratio can be set here\n    \n    cmds.separator( style=\"in\", height=4 )  # Adds spacing\n    cmds.button( label=\"Calculate Velocity\", command=lambda _: setWorkingScale(objs,scaleOption), width=(width-10) )\n    \n    cmds.separator( style=\"in\", height=4 )  # Adds spacing\n    target = \"target >> \" + objs[0]\n    \n    cmds.text( label=target, wordWrap=True, width=(width-10), font=\"smallBoldLabelFont\" )\n\n    cmds.setParent(\"..\") \n    cmds.setParent(\"..\")  \n\n    cmds.showWindow(\"scalePromptWin\")\n\ndef checkSel(objs): \n    print(f\"checking that the selection is a single object...\")\n    cnt = len(objs)\n    if( cnt!=1 ):\n        cmds.confirmDialog( title=\"Selection Checker\", message=(str(cnt) + \" objects were selected.\\n\" + \"Please select one (1) object and try again.\\n \\n\" + \"Want to track a vertex? \\n\" + \"Enter component mode, select one (1) vertex and try again.\"), button=[\"Close\"], defaultButton=\"Close\" )\n        return\n\n    create_scale_prompt(objs)\n    \n# Rune Script\ncheckSel(sel)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
