        -image1 "material_create.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "# Copy the materials from the first selected hierarchy to the second.\n# select the two top most parent objects. \nimport maya.cmds as cmds\n\ndef copy_material(source_object, target_object):\n    \"\"\"Copies material from source object to target object.\"\"\"\n    \n    # Get the shading group of the source object\n    shading_group = cmds.listConnections(source_object, type='shadingEngine')[0]\n\n    # Assign the shading group to the target object\n    cmds.sets(target_object, e=True, forceElement=shading_group)\n\ndef compare_vertices_polycompare(obj1, obj2):\n    \"\"\"\n    Checks if two objects have the same vertices using polyCompare.\n\n    Args:\n        obj1 (str): Name of the first object.\n        obj2 (str): Name of the second object.\n\n    Returns:\n        bool: True if the objects have the same vertices, False otherwise.\n    \"\"\"\n\n    result = cmds.polyCompare(obj1, obj2, vertices=True)\n    return result == 0\n\nsel = cmds.ls(selection=True)\ncmds.select(clear=True)\n\nobjs = cmds.listRelatives(sel[0],allDescendents=True,type=\"transform\",fullPath=True) # list children in reverse full path to object\nobjShort = cmds.listRelatives(sel[0],allDescendents=True,type=\"transform\")\nobjs_tgt = cmds.listRelatives(sel[1],allDescendents=True,type=\"transform\",fullPath=True) # target geo \nobjShort_tgt = cmds.listRelatives(sel[1],allDescendents=True,type=\"transform\")\n\nfor i in range(len(objs)):\n    obj = objs[i]\n    shapeA = cmds.listRelatives(obj,allDescendents=True,shapes=True,fullPath=True)\n    obj_tgt = objs_tgt[i]\n    shapeB = cmds.listRelatives(obj_tgt,allDescendents=True,shapes=True,fullPath=True) \n    objSh = objShort[i]\n    \n    \n    if \"_geo\" in objSh: # check that it's geometry\n        copy_material(shapeA, shapeB) " 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
