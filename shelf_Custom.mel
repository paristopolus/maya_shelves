        -command "\n# Maya 2026 - Curve Shape Drawing Override Color (Red/Blue/Yellow)\nimport maya.cmds as cmds\n\ndef set_curve_override_color_from_prompt():\n    # Prompt user for a color choice\n    choice = cmds.confirmDialog(\n        title=\"Curve Override Color\",\n        message=\"Choose an override color for selected curve shapes:\",\n        button=[\"Red\", \"Blue\", \"Yellow\", \"Cancel\"],\n        defaultButton=\"Red\",\n        cancelButton=\"Cancel\",\n        dismissString=\"Cancel\"\n    )  # confirmDialog returns the label of the pressed button [3](https://help.autodesk.com/cloudhelp/2026/ENU/Maya-Tech-Docs/CommandsPython/confirmDialog.html)\n\n    if choice == \"Cancel\":\n        return\n\n    # Maya's indexed override colors commonly used for curve controls:\n    # Red=13, Blue=6, Yellow=17 [1](https://forums.autodesk.com/t5/maya-programming-forum/change-colour-of-curve-objects/td-p/9766686)[2](http://davy.chang.free.fr/index.php/maya/melscript/melscript-change-color-index-on-selected-objects/)\n    color_index_map = {\n        \"Red\": 13,\n        \"Blue\": 6,\n        \"Yellow\": 17\n    }\n    color_index = color_index_map[choice]\n\n    sel = cmds.ls(selection=True, long=True) or []\n    if not sel:\n        cmds.warning(\"Nothing selected. Please select one or more curve transforms/shapes.\")\n        return\n\n    # Collect nurbsCurve shapes from the selection:\n    curve_shapes = []\n\n    for node in sel:\n        ntype = cmds.nodeType(node)\n\n        # If user directly selected a shape:\n        if ntype == \"nurbsCurve\":\n            curve_shapes.append(node)\n            continue\n\n        # If user selected a transform (or something else), search its shapes:\n        shapes = cmds.listRelatives(node, shapes=True, fullPath=True) or []\n        for s in shapes:\n            if cmds.nodeType(s) == \"nurbsCurve\":\n                curve_shapes.append(s)\n\n    # De-duplicate while preserving order\n    seen = set()\n    curve_shapes = [s for s in curve_shapes if not (s in seen or seen.add(s))]\n\n    if not curve_shapes:\n        cmds.warning(\"No nurbsCurve shapes found in selection.\")\n        return\n\n    # Apply drawing override on each curve shape\n    for shape in curve_shapes:\n        try:\n            cmds.setAttr(shape + \".overrideEnabled\", 1)\n            cmds.setAttr(shape + \".overrideRGBColors\", 0)  # ensure indexed mode\n            cmds.setAttr(shape + \".overrideColor\", color_index)\n        except Exception as e:\n            cmds.warning(\"Failed on {}: {}\".format(shape, e))\n\n    cmds.inViewMessage(\n        amg=\"Applied <hl>{}</hl> override to <hl>{}</hl> curve shape(s).\".format(choice, len(curve_shapes)),\n        pos=\"topCenter\",\n        fade=True\n    )\n\n# Run it\nset_curve_override_color_from_prompt()\n" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
